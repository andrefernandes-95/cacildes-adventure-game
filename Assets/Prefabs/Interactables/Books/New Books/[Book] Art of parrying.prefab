--- !u!114 &7671758478460865975
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4390829204225908020}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3806d7fd0c8280047ad8102a1ab39edf, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  pageTitle: 
  pageText: "After careful examination of his foe\u2019s battle dance, Mial reached
    a decision: \"I'll parry you, dweller of darkness\", and so he did. Two perfect
    parries using [Right Mouse Button, L1 in gamepad] from his bare hands and the
    caveman fell and bent the knee. Mial, pitiless, stroked with a vengeful slash,
    pulling the final curtain into the caveman\u2019s eyes.\r\n\r\nNow, Mial had
    discovered the power of parrying an opponent, and how it had saved his life.
    \"I didn\u2019t even take damage from parrying\", he concluded.\r"
