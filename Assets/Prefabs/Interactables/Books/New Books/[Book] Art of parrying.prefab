--- !u!114 &3994181155504684200
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 510499968720998757}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3806d7fd0c8280047ad8102a1ab39edf, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  pageTitle: 
  pageText: "As a conclusion to this cautionary tale, one should not attempt to parry
    a foe he has not seen before. So let the enemy swing, give him space to fail
    and dodge when necessary. Only after meticulous study of one\u2019s enemy patterns
    should the art of parrying be attempted.\r\n\r\nAnd always wear your armor.\r"
