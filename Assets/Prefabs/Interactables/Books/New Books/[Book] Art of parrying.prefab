--- !u!114 &8122330961663856898
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1692027661102846108}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3806d7fd0c8280047ad8102a1ab39edf, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  pageTitle: 
  pageText: 'Feeling light and overly confident, Mial thought of abandoning his heavy,
    cumbersome armor and running around naked throughout the rest of his journey.


    Indeed,
    Mial, The Naked would meet his end shortly after leaving that cave, when he tried
    to parry a bandit near the woods. This foe he had not studied carefully beforehand,
    and so Mial missed his parry timings.


    And Mial, The Naked was no more.'
