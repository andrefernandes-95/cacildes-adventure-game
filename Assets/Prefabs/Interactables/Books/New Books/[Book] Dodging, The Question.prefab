--- !u!114 &802895352191210894
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6387842056916598509}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3806d7fd0c8280047ad8102a1ab39edf, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  pageTitle: 
  pageText: "Mial was down to his last health potion.\r\n\r\nHe knew he had one more
    deadly caveman to face, and after many attempts at dodging his foe\u2019s strikes,
    he had come to terms with his lack of skill in rolling under heavy armor.\r\n\r\n\"A
    true adventurer\", he thought, \"would have kept an eye on the ways this caveman
    attacks. If only I could memorize his swing patterns, I could try to parry them,
    and maybe break his guard.\"\r"
