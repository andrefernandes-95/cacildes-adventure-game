  m_Name: 
  m_EditorClassIdentifier: 
  character: {fileID: 11400000, guid: 53a4d8b4e4705a24f9fc7fd33040fe85, type: 2}
  message: Your kindness has granted us peace of mind. Take this token of our gratitude.
    It's not just a reward; it's a symbol of the strength you've given to all of
    us in these trying times.
  responses: []
