--- !u!114 &7913453798430198516
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1045584439460069467}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c8aa3f3cae44ad24590de72453d413b7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  character: {fileID: 11400000, guid: 53a4d8b4e4705a24f9fc7fd33040fe85, type: 2}
  message: My sister is back! I'm so grateful for your help. She's understandably
    shaken up by her ordeal, and it's going to take some time for her to heal. I'm
    afraid she might be experiencing some... stress from it all. We need to give
    her some space and time to process what she's been through...
  responses: []
--- !u!114 &4664072336047884880
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1045584439460069467}
