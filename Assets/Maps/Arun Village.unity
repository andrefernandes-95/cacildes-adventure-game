--- !u!114 &141434625
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 141434623}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 433ca407a0ceafe46947512bccfaedf4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  text: What's the story of this place?
  onResponseSelected:
    m_PersistentCalls:
      m_Calls: []
  onResponseFinished:
    m_PersistentCalls:
      m_Calls: []
  subEventPage: {fileID: 0}
  replier: {fileID: 11400000, guid: 0e1005fecc533004fb986723ee1afe67, type: 2}
  reply: "You're standing on the sacred grounds of Arun, the first elf. He was part
    of a powerful being named Sayad, tormented by the weight of his own thoughts.
    Legend has it that Sayad split his soul in two: Molok, the obscure part, which
    gave rise to the orcs, and Arun, the lighter side, which birthed us, the elves.
    This settlement was once Arun's home, naturally evolving into the birthplace
    of the elves on Ministeria, who have since dispersed across the world. I apologize
    if I'm getting a bit too engrossed in this elven lore\u2014it's deeply rooted
    in my ancestry, after all."
  reputationAmountToIncrease: 0
  reputationAmountToDecrease: 0
  reputationToAwardMonobehaviourID: {fileID: 0}
