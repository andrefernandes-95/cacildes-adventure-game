  m_Script: {fileID: 11500000, guid: 433ca407a0ceafe46947512bccfaedf4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  text: '[Ask about herself...]'
  onResponseSelected:
    m_PersistentCalls:
      m_Calls: []
  onResponseFinished:
    m_PersistentCalls:
      m_Calls: []
  subEventPage: {fileID: 0}
  replier: {fileID: 11400000, guid: 333a897fb371c7c4f821e7700ce5ed28, type: 2}
  reply: "I'm just a woodworker, skilled in the ways of Elven woodcraft. My bows
    are enough to keep me going and make a name for myself in these parts. But there's
    this vision I can't shake off\u2014a bow I've only ever seen in my dreams. Someday,
    maybe, I'll find the wood it needs to become real.\r"
  reputationAmountToIncrease: 0
  reputationAmountToDecrease: 0
  reputationToAwardMonobehaviourID: {fileID: 0}
