--- !u!114 &358670045
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 358670043}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 433ca407a0ceafe46947512bccfaedf4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  text: What's up in Elven Town?
  onResponseSelected:
    m_PersistentCalls:
      m_Calls: []
  onResponseFinished:
    m_PersistentCalls:
      m_Calls: []
  subEventPage: {fileID: 0}
  replier: {fileID: 11400000, guid: 333a897fb371c7c4f821e7700ce5ed28, type: 2}
  reply: You speak of our village, do you not? Indeed, the air is thick with tension
    as the orc lays his foot on our sacred temple. I cannot bear to contemplate the
    consequences, should he destroy our stone. It sources our forest and trees...
    But I must hold on hope. Your presence here is a beacon of courage. Tales have
    reached our ears of your valiant confrontations with the orcs in their own lair.
    You have confronted darkness before. I trust in your aid.
  reputationAmountToIncrease: 0
  reputationAmountToDecrease: 0
  reputationToAwardMonobehaviourID: {fileID: 0}
