    - target: {fileID: 3566688100871027034, guid: b64309fb909acab4ca852b740337efc1, type: 3}
      propertyPath: message
      value: "<i>Anathar... land of the mighty Frostynax.\r\nI found him silent upon
        the peak, where no stars dare to shine.\r\nThere, I broke the stillness\u2014\r\nand
        tore from him the heart that burned the Cold Fire Flame.\r\n\r\nMy brother,
        Thorum, rose from his deathbed, the sickness seared away\u2014\r\nCleansed
        by the same fire that damned me.</i>"
      objectReference: {fileID: 0}
