  character: {fileID: 11400000, guid: f33307f434879de43aaab010e52d9b19, type: 2}
  message: 'And here I thought you were just a gardener.

'
  responses: []
--- !u!114 &928252533
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 928252527}
  m_Enabled: 1
