  m_Name: 
  m_EditorClassIdentifier: 
  character: {fileID: 11400000, guid: f33307f434879de43aaab010e52d9b19, type: 2}
  message: I've heard this tale in my childhood... and the book that Balbino took...
    what did the librarian say it was... The Book of Sayad?
  responses: []
--- !u!114 &928252531
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 928252527}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c8aa3f3cae44ad24590de72453d413b7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  character: {fileID: 11400000, guid: 7fc973e90fac21443b2360d5dcfb5cc3, type: 2}
  message: The day came that I decided to split my terrifying power. With ancient
    magic, I split my soul in two. In the end, I extracted too much from either side.
    One of me became Arun, the first elf. The other became Molok, the first orc.
  responses:
  - {fileID: 620397319}
  - {fileID: 565375990}
--- !u!114 &928252532
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
