  character: {fileID: 11400000, guid: be3b73e073d588a49865462f064213dc, type: 2}
  message: "She\u2019s... gone... I\u2019m sorry... it\u2019s taking me time to process
    this. I spent my life hunting her... What am I to do now? It feels unreal...
    perhaps I never truly believed this day would come. And now, here we are..."
  responses: []
  companionDatabase: {fileID: 11400000, guid: 304c7a15385a5904b83eaaa8ed072aa2, type: 2}
  companionID: {fileID: 11400000, guid: 855bb2b71671a5142a03359a56df6fff, type: 2}
