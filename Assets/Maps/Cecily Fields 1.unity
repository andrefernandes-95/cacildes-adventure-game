    - target: {fileID: 831183410218012187, guid: 444719d241a145d409b8f57fe4918b6c, type: 3}
      propertyPath: message.localizedTexts.Array.data[0].text
      value: "Tens uma fazenda bonita, Cacildes. Espero que me convides para a tua
        festa de anivers\xE1rio, n\xE3o me importaria de ter um dia de folga no campo,
        partilhar comida humana e deixar o meu escudo descansar."
      objectReference: {fileID: 0}
    - target: {fileID: 831183410218012187, guid: 444719d241a145d409b8f57fe4918b6c, type: 3}
      propertyPath: message.localizedTexts.Array.data[1].text
      value: You have a beautiful house, Cacildes. I hope you invite me to your birthday
        party, wouldn't mind having a day off in the countryside to break human bread
        and leave my shield to rest.
      objectReference: {fileID: 0}
