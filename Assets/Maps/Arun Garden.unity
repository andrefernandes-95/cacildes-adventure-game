--- !u!1001 &99621195491353077
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 25864092}
    m_Modifications:
    - target: {fileID: 150168758122823813, guid: 522725deb9587de4ab9db0113c2e0e25, type: 3}
      propertyPath: message
      value: Wow... slow down there... the orc stone is here? Then where's the elven
        stone?
      objectReference: {fileID: 0}
    - target: {fileID: 150168758122823813, guid: 522725deb9587de4ab9db0113c2e0e25, type: 3}
      propertyPath: uIDocumentDialogueWindow
