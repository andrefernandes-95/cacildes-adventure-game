  m_Name: 
  m_EditorClassIdentifier: 
  character: {fileID: 11400000, guid: 31e4fbd2b8922a94ba608fa6eea202d2, type: 2}
  message: Name's Drent. I see you've dealt with those thieves, eh? About time someone
    drove them out of my dwelling. It's been unbearable down here, what with all
    their love ballads about their leader. Now, I can finally rest easy, with naught
    but the soothing sound of flowing water to bless my dreams.
  responses:
  - {fileID: 139135653}
  - {fileID: 913570568}
  - {fileID: 906650193}
