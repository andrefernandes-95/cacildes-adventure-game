    - target: {fileID: 831183410218012187, guid: 444719d241a145d409b8f57fe4918b6c, type: 3}
      propertyPath: message.localizedTexts.Array.data[0].text
      value: "Estou a gostar de descobrir todos estes lugares, meu amigo. Com os
        orcs, eram s\xF3 cavernas e escurid\xE3o. O ar por estas paragens parece
        ser verdadeiro!"
      objectReference: {fileID: 0}
    - target: {fileID: 831183410218012187, guid: 444719d241a145d409b8f57fe4918b6c, type: 3}
      propertyPath: message.localizedTexts.Array.data[1].text
      value: I'm enjoying discovering all these places, my friend. With orcs, it
        was all caverns and darkness. The air in these parts feels like real air!
      objectReference: {fileID: 0}
