--- !u!114 &1868357925
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1868357922}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c8aa3f3cae44ad24590de72453d413b7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  character: {fileID: 11400000, guid: 4ef43e90772d0194fbd903c394b6ecd5, type: 2}
  message: 'You, though, you did great. Be sure to collect any rewards around here,
    and then get the hell out. This place has worn out its welcome, if you know what
    I mean.


    Oh, and meet me back at the tavern when you return to Cecily Town.
    I''ll make sure everyone buys you a drink after I tell them all about your heroic
    deeds. Haha.'
  responses: []
--- !u!114 &1868357926
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1868357922}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c8aa3f3cae44ad24590de72453d413b7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  character: {fileID: 11400000, guid: 4ef43e90772d0194fbd903c394b6ecd5, type: 2}
  message: "Phew... thanks for freeing me. I was starting to think this was it for
    me. And those orcs... off to Arun's Temple? That's not good. I'll head back to
    the general and report all of it. He'll be glad I'm alive, but mad about my foolhardy
    expedition. But that's my problem.\r"
  responses: []
--- !u!114 &1868357927
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1868357922}
  m_Enabled: 1
