  m_Script: {fileID: 11500000, guid: c8aa3f3cae44ad24590de72453d413b7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  character: {fileID: 11400000, guid: 722be3c6a10fdb6409ff1a602e3adc90, type: 2}
  message: Ah, you've made it this far. Admirable spirit, kid. But it was in vain.
    Nothing can stop us, not you, nor your captain or your little human town. The
    long night descends upon the elves, and anyone who dares stand in our path shall
    taste the wrath of Molok.
  responses: []
