      value: Who are you?
      objectReference: {fileID: 0}
    - target: {fileID: 5136461691029717935, guid: 7c6376aeb2e104c4c85017d27cabf3f2, type: 3}
      propertyPath: reply
      value: "I'm a Sundered. Since birth, our people have lived in servitude, bound
        by shackles. By the time freedom arrived, it was already too late - we had
        grown accustomed to the shadows of these mountains.\r"
      objectReference: {fileID: 0}
