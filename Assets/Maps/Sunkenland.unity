  m_Script: {fileID: 11500000, guid: 433ca407a0ceafe46947512bccfaedf4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  text: Do you live here?
  onResponseSelected:
    m_PersistentCalls:
      m_Calls: []
  onResponseFinished:
    m_PersistentCalls:
      m_Calls: []
  subEventPage: {fileID: 0}
  replier: {fileID: 11400000, guid: 6f70b57dd0c5542498359cbf1877d6dc, type: 2}
  reply: Aye, but I'm more adventurous than most of my sundered folk. I enjoy exploring
    the islands around the Slepbone region by boat, returning with new loot and tales
    to share. It gets dull in Sunkenland. And that castle gives me the creeps.
  reputationAmountToIncrease: 0
  reputationAmountToDecrease: 0
  reputationToAwardMonobehaviourID: {fileID: 0}
