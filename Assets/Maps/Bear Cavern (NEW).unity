  m_Name: 
  m_EditorClassIdentifier: 
  character: {fileID: 11400000, guid: a82c20dd261c8e047a3db9d63c8acc69, type: 2}
  message: Did you know Dandelions can release their seeds whenever they want? If
    it's rainy, they know their seeds won't go very far because of the weight of
    rain drops... so they wait for the wind instead. Clever, eh?
  responses: []
